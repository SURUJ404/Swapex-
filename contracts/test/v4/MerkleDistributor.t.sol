pragma solidity ^0.8.26;

import {Test} from "forge-std/Test.sol";
import {TimelockController} from "@openzeppelin/contracts/governance/TimelockController.sol";
import {Ownable} from "@openzeppelin/contracts/access/Ownable.sol";
import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
import {MerkleDistributor} from "../../src/v4/periphery/MerkleDistributor.sol";
import {MockERC20} from "../mocks/MockERC20.sol";

/// C - Merkle allowlist distributions (docs/CRYPTO_DECISIONS.md section C):
/// the on-chain half of the item's acceptance criteria: "a test that proves forged proofs
/// and duplicate claims fail". Claims are consumed from a fixture GENERATED BY THE
/// TYPESCRIPT GENERATOR (apps/web/scripts/merkle.ts, `npm run merkle`), so this suite is
/// also the cross-language check: JavaScript-built roots/proofs must satisfy the audited
/// OpenZeppelin MerkleProof verifier, and tests/merkle.test.ts folds the same proofs
/// independently. Fixture: contracts/test/fixtures/{allowlist.json,merkle.json}.
contract MerkleDistributorTest is Test {
    // well-known anvil accounts, same set as the allowlist fixture
    address internal constant A0 = 0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266;
    address internal constant A1 = 0x70997970C51812dc3A010C7d01b50e0d17dc79C8;
    address internal constant A2 = 0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC;
    address internal constant A3 = 0x90F79bf6EB2c4f870365E785982E1f101E93b906;
    address internal constant RELAYER = address(0xB0B);

    uint256 internal constant DELAY = 2 days;

    string internal json;
    bytes32 internal root;
    uint256 internal count;
    MockERC20 internal token;
    MerkleDistributor internal dist;

    event Claimed(uint256 indexed index, address indexed account, uint256 amount);
    event RootUpdated(bytes32 previousRoot, bytes32 newRoot);

    function setUp() public {
        json = vm.readFile("test/fixtures/merkle.json");
        root = abi.decode(vm.parseJson(json, ".root"), (bytes32));
        count = abi.decode(vm.parseJson(json, ".count"), (uint256));
        assertEq(count, 4, "fixture must carry all four demo claims");

        token = new MockERC20("Swapex A", "SWA", 18);
        dist = new MerkleDistributor(IERC20(address(token)), root, address(this));
        token.mint(address(dist), 10 ether); // fixture pays out 1+2+3+4 ether
    }

    // ------------------------------------------------------- fixture plumbing

    /// Load claim `i` from the JS-generated fixture (index / account / amount / proof).
    /// Fixture encodings (probed): numbers and 32-byte hex strings decode raw, JSON
    /// strings (amounts, kept as decimal strings so any size round-trips) decode to
    /// string and are parsed with vm.parseUint.
    function _claim(uint256 i)
        internal
        view
        returns (uint256 index, address account, uint256 amount, bytes32[] memory proof)
    {
        string memory base = string.concat(".claims[", vm.toString(i), "]");
        index = abi.decode(vm.parseJson(json, string.concat(base, ".index")), (uint256));
        account = abi.decode(vm.parseJson(json, string.concat(base, ".account")), (address));
        amount = vm.parseUint(abi.decode(vm.parseJson(json, string.concat(base, ".amount")), (string)));
        proof = abi.decode(vm.parseJson(json, string.concat(base, ".proof")), (bytes32[]));
    }

    function _dropFirst(bytes32[] memory p) internal pure returns (bytes32[] memory q) {
        q = new bytes32[](p.length - 1);
        for (uint256 i = 1; i < p.length; i++) {
            q[i - 1] = p[i];
        }
    }

    /// sorted-pair hash, mirroring Hashes.commutativeKeccak256 (used only to hand-build
    /// the deliberately-wrong single-hash tree in the second-preimage test)
    function _pair(bytes32 a, bytes32 b) internal pure returns (bytes32) {
        return a < b ? keccak256(abi.encodePacked(a, b)) : keccak256(abi.encodePacked(b, a));
    }

    // ------------------------------------------------------- happy path / relay

    function test_claim_jsGeneratedProofPaysAccount() public {
        (uint256 index, address account, uint256 amount, bytes32[] memory proof) = _claim(0);
        assertEq(account, A0);
        assertEq(amount, 1 ether);
        assertFalse(dist.isClaimed(index));

        vm.expectEmit(true, true, false, true, address(dist));
        emit Claimed(index, account, amount);
        dist.claim(index, account, amount, proof);

        assertTrue(dist.isClaimed(index));
        assertEq(token.balanceOf(account), 1 ether);
        assertEq(token.balanceOf(address(dist)), 9 ether);
    }

    function test_claim_permissionlessRelay_creditsLeafAccountNotCaller() public {
        (uint256 index, address account, uint256 amount, bytes32[] memory proof) = _claim(0);
        vm.prank(RELAYER);
        dist.claim(index, account, amount, proof);
        assertEq(token.balanceOf(account), 1 ether, "leaf account credited");
        assertEq(token.balanceOf(RELAYER), 0, "relayer gets nothing");
    }

    function test_claim_everyFixtureEntry_paysOut() public {
        uint256 total;
        for (uint256 i = 0; i < count; i++) {
            (uint256 index, address account, uint256 amount, bytes32[] memory proof) = _claim(i);
            dist.claim(index, account, amount, proof);
            assertTrue(dist.isClaimed(index), "slot marked");
            assertEq(token.balanceOf(account), amount, "exact amount");
            total += amount;
        }
        assertEq(total, 10 ether, "all fixture payouts sum to the funded amount");
        assertEq(token.balanceOf(address(dist)), 0);
    }

    // ------------------------------------------------------- duplicate claims

    function test_duplicateClaim_revertsSecondAttempt() public {
        (uint256 index, address account, uint256 amount, bytes32[] memory proof) = _claim(0);
        dist.claim(index, account, amount, proof);
        vm.expectRevert(abi.encodeWithSelector(MerkleDistributor.AlreadyClaimed.selector, index));
        dist.claim(index, account, amount, proof);
    }

    function test_duplicateClaim_eachFixtureSlotPaysAtMostOnce() public {
        for (uint256 i = 0; i < count; i++) {
            (uint256 index, address account, uint256 amount, bytes32[] memory proof) = _claim(i);
            dist.claim(index, account, amount, proof);
            vm.expectRevert(abi.encodeWithSelector(MerkleDistributor.AlreadyClaimed.selector, index));
            dist.claim(index, account, amount, proof);
        }
        // balances unchanged by the failed re-claims
        assertEq(token.balanceOf(A0), 1 ether);
        assertEq(token.balanceOf(A1), 2 ether);
        assertEq(token.balanceOf(A2), 3 ether);
        assertEq(token.balanceOf(A3), 4 ether);
    }

    // ------------------------------------------------------- claim bitmap

    function test_bitmap_slotsAcrossWordBoundaryAreIndependent() public {
        (uint256 i0, address a0, uint256 v0, bytes32[] memory p0) = _claim(0); // word 0, bit 0
        (uint256 i1, address a1, uint256 v1, bytes32[] memory p1) = _claim(1); // word 0, bit 1
        (uint256 i2, address a2, uint256 v2, bytes32[] memory p2) = _claim(2); // word 0, bit 2
        (uint256 i3, address a3, uint256 v3, bytes32[] memory p3) = _claim(3); // word 1, bit 0
        assertEq(i0, 0);
        assertEq(i3, 256, "fixture must exercise the second bitmap word");

        dist.claim(i0, a0, v0, p0);
        dist.claim(i3, a3, v3, p3);
        assertTrue(dist.isClaimed(0));
        assertTrue(dist.isClaimed(256));
        assertFalse(dist.isClaimed(1), "word 0 untouched by claims 0 and 256");
        assertFalse(dist.isClaimed(255), "word 0 high bit untouched");
        assertFalse(dist.isClaimed(257), "word 1 next bit untouched");

        dist.claim(i1, a1, v1, p1);
        dist.claim(i2, a2, v2, p2);
        assertTrue(dist.isClaimed(1));
        assertTrue(dist.isClaimed(2));
        assertFalse(dist.isClaimed(257));
    }

    // ------------------------------------------------------- forged proofs

    function test_forged_tamperedAmount_reverts() public {
        (uint256 index, address account,, bytes32[] memory proof) = _claim(0);
        vm.expectRevert(MerkleDistributor.InvalidProof.selector);
        dist.claim(index, account, 1 ether + 1, proof);
    }

    function test_forged_tamperedAccount_reverts() public {
        (uint256 index,, uint256 amount, bytes32[] memory proof) = _claim(0);
        vm.expectRevert(MerkleDistributor.InvalidProof.selector);
        dist.claim(index, A1, amount, proof); // A1's own claim exists elsewhere in the tree
    }

    function test_forged_tamperedIndex_reverts() public {
        (, address account, uint256 amount, bytes32[] memory proof) = _claim(0);
        vm.expectRevert(MerkleDistributor.InvalidProof.selector);
        dist.claim(1, account, amount, proof); // proof belongs to slot 0's leaf
    }

    function test_forged_emptyProof_reverts() public {
        (uint256 index, address account, uint256 amount,) = _claim(0);
        bytes32[] memory empty = new bytes32[](0);
        vm.expectRevert(MerkleDistributor.InvalidProof.selector);
        dist.claim(index, account, amount, empty);
    }

    function test_forged_truncatedProof_reverts() public {
        (uint256 index, address account, uint256 amount, bytes32[] memory proof) = _claim(0);
        bytes32[] memory shorter = _dropFirst(proof);
        vm.expectRevert(MerkleDistributor.InvalidProof.selector);
        dist.claim(index, account, amount, shorter);
    }

    function test_forged_staleProofAfterRootRotation_reverts() public {
        (uint256 index, address account, uint256 amount, bytes32[] memory proof) = _claim(0);
        dist.setRoot(bytes32(uint256(0xBAD)));
        vm.expectRevert(MerkleDistributor.InvalidProof.selector);
        dist.claim(index, account, amount, proof);
    }

    function test_forged_proofForClaimIsNotValidForAnotherSlotOrAccount() public {
        // cross-entry replay: slot 0's proof against slot 1's identity
        (uint256 i0,, uint256 v0, bytes32[] memory p0) = _claim(0);
        (uint256 i1, address a1,,) = _claim(1);
        vm.expectRevert(MerkleDistributor.InvalidProof.selector);
        dist.claim(i1, a1, v0, p0);
        // and the mirror image: slot 1's own identity with slot 0's slot number
        vm.expectRevert(MerkleDistributor.InvalidProof.selector);
        dist.claim(i0, a1, v0, p0);
    }

    // ------------------------------------------------------- second-preimage

    function test_leafOf_isDoubleHashedAndNeverMatchesAnInternalNode() public {
        (uint256 index, address account, uint256 amount, bytes32[] memory proof) = _claim(0);
        bytes32 leaf = dist.leafOf(index, account, amount);

        // the canonical leaf differs from the naive single hash an old-style tree would use
        bytes32 singleHashed = keccak256(abi.encode(index, account, amount));
        assertTrue(leaf != singleHashed, "double hash required");
        assertEq(leaf, keccak256(abi.encodePacked(singleHashed)), "inner hash exactly once more");

        // and no proof element (an internal node of this very tree) equals any claim leaf
        for (uint256 i = 0; i < count; i++) {
            (uint256 j, address a, uint256 v, bytes32[] memory pj) = _claim(i);
            bytes32 l = dist.leafOf(j, a, v);
            for (uint256 k = 0; k < pj.length; k++) {
                assertTrue(l != pj[k], "leaf must not equal an internal node");
            }
        }
        assertTrue(proof.length > 0);
    }

    function test_forged_singleHashedTreeCannotPayDoubleHashedLeaves() public {
        // even if an attacker fully controls the root - a tree built over SINGLE-hashed
        // leaves - the contract still refuses, because it always derives the double hash:
        // leaf = keccak256(abi.encode(index, account, amount)) cannot fold to
        // pair(keccak256(abi.encode(...)), sibling).
        bytes32 sh0 = keccak256(abi.encode(uint256(0), A0, uint256(1 ether)));
        bytes32 sh1 = keccak256(abi.encode(uint256(1), A1, uint256(2 ether)));
        bytes32 wrongRoot = _pair(sh0, sh1);
        MerkleDistributor wrongTree = new MerkleDistributor(IERC20(address(token)), wrongRoot, address(this));

        bytes32[] memory proof = new bytes32[](1);
        proof[0] = sh1; // the "correct" single-hash proof for this forged tree
        vm.expectRevert(MerkleDistributor.InvalidProof.selector);
        wrongTree.claim(0, A0, 1 ether, proof);
    }

    // ------------------------------------------------------- fuzzed forgery

    function testFuzz_forgedClaimsNeverValidate(uint256 index, address account, uint256 amount) public {
        vm.assume(account != address(0));
        vm.assume(amount != 0);
        bytes32 leaf = dist.leafOf(index, account, amount);
        // reject only the four genuine fixture leaves (they legitimately claim)
        for (uint256 i = 0; i < count; i++) {
            (uint256 j, address a, uint256 v,) = _claim(i);
            vm.assume(leaf != dist.leafOf(j, a, v));
        }
        vm.expectRevert(MerkleDistributor.InvalidProof.selector);
        dist.claim(index, account, amount, new bytes32[](0));
    }

    // ------------------------------------------------------- root rotation

    function test_setRoot_onlyOwnerCanRotate() public {
        bytes32 newRoot = bytes32(uint256(0xBEEF));
        vm.expectRevert(abi.encodeWithSelector(Ownable.OwnableUnauthorizedAccount.selector, RELAYER));
        vm.prank(RELAYER);
        dist.setRoot(newRoot);
        assertEq(dist.merkleRoot(), root);
    }

    function test_setRoot_emitsRotationAndTakesEffect() public {
        bytes32 newRoot = bytes32(uint256(0xBEEF));
        vm.expectEmit(false, false, false, true, address(dist));
        emit RootUpdated(root, newRoot);
        dist.setRoot(newRoot);
        assertEq(dist.merkleRoot(), newRoot);
    }

    function test_setRoot_zeroRootReverts() public {
        vm.expectRevert(MerkleDistributor.ZeroRoot.selector);
        dist.setRoot(bytes32(0));
    }

    function test_setRoot_routedThroughTimelock_scheduleExecuteAndCancel() public {
        // deploy as production does: owner is the TimelockController, never an EOA
        address[] memory members = new address[](1);
        members[0] = address(this); // proposer + executor, as in script/Deploy.s.sol
        TimelockController tl = new TimelockController(DELAY, members, members, address(this));
        MerkleDistributor gated = new MerkleDistributor(IERC20(address(token)), root, address(tl));

        bytes32 newRoot = bytes32(uint256(0xDEAD));
        bytes memory data = abi.encodeCall(MerkleDistributor.setRoot, (newRoot));
        bytes32 salt = bytes32(0);
        bytes32 predecessor = bytes32(0);

        // direct EOA call: the owner is the timelock, not this contract
        vm.expectRevert(abi.encodeWithSelector(Ownable.OwnableUnauthorizedAccount.selector, address(this)));
        gated.setRoot(newRoot);

        // queue -> delay -> execute
        tl.schedule(address(gated), 0, data, predecessor, salt, DELAY);
        vm.expectRevert(); // too early: delay has not elapsed
        tl.execute(address(gated), 0, data, predecessor, salt);
        vm.warp(block.timestamp + DELAY);
        tl.execute(address(gated), 0, data, predecessor, salt);
        assertEq(gated.merkleRoot(), newRoot, "timelocked rotation applied");

        // a queued rotation stays cancellable during the delay (TESTNET_SECURITY semantics)
        bytes32 newRoot2 = bytes32(uint256(0xF00D));
        bytes memory data2 = abi.encodeCall(MerkleDistributor.setRoot, (newRoot2));
        bytes32 opId = tl.hashOperation(address(gated), 0, data2, predecessor, salt);
        tl.schedule(address(gated), 0, data2, predecessor, salt, DELAY);
        tl.cancel(opId);
        vm.warp(block.timestamp + DELAY);
        vm.expectRevert(); // cancelled: can never execute
        tl.execute(address(gated), 0, data2, predecessor, salt);
        assertEq(gated.merkleRoot(), newRoot, "cancelled rotation never applied");
    }

    // ------------------------------------------------------- constructor guards

    function test_constructor_zeroTokenReverts() public {
        vm.expectRevert(MerkleDistributor.ZeroToken.selector);
        new MerkleDistributor(IERC20(address(0)), root, address(this));
    }

    function test_constructor_zeroRootReverts() public {
        vm.expectRevert(MerkleDistributor.ZeroRoot.selector);
        new MerkleDistributor(IERC20(address(token)), bytes32(0), address(this));
    }

    function test_constructor_zeroOwnerReverts() public {
        vm.expectRevert(abi.encodeWithSelector(Ownable.OwnableInvalidOwner.selector, address(0)));
        new MerkleDistributor(IERC20(address(token)), root, address(0));
    }

    // ------------------------------------------------------- claim input guards

    function test_claim_zeroAccountReverts() public {
        (uint256 index,, uint256 amount, bytes32[] memory proof) = _claim(0);
        vm.expectRevert(MerkleDistributor.ZeroAccount.selector);
        dist.claim(index, address(0), amount, proof);
    }

    function test_claim_zeroAmountReverts() public {
        (uint256 index, address account,, bytes32[] memory proof) = _claim(0);
        vm.expectRevert(MerkleDistributor.ZeroAmount.selector);
        dist.claim(index, account, 0, proof);
    }

    // ------------------------------------------------------- reentrancy

    function test_claim_reentrantTokenCannotClaimTwice() public {
        ReenterClaimToken evil = new ReenterClaimToken("Evil", "EVL", 18);
        MerkleDistributor guarded = new MerkleDistributor(IERC20(address(evil)), root, address(this));
        evil.mint(address(guarded), 10 ether);

        (uint256 index, address account, uint256 amount, bytes32[] memory proof) = _claim(0);
        evil.armReentry(guarded, index, account, amount, proof);
        guarded.claim(index, account, amount, proof); // outer claim must succeed

        assertTrue(dist.isClaimed(index) == false, "unrelated distributor untouched");
        assertTrue(guarded.isClaimed(index), "outer claim recorded");
        assertEq(evil.reentryAttempts(), 1, "token attempted reentry during transfer");
        assertEq(evil.reentrySuccesses(), 0, "reclaim must fail - CEI marks claimed first");
        assertEq(evil.balanceOf(account), amount, "payout landed exactly once");
    }
}

/// @dev ERC-20 whose `transfer` re-enters `MerkleDistributor.claim` with the SAME
///      (index, account, amount, proof) it was just paid for. Checks-effects-interactions
///      in `claim` must make the inner call revert with AlreadyClaimed, so the outer
///      payout stands and nothing is paid twice.
contract ReenterClaimToken {
    string public name;
    string public symbol;
    uint8 public immutable decimals;
    uint256 public totalSupply;
    mapping(address => uint256) public balanceOf;

    event Transfer(address indexed from, address indexed to, uint256 value);

    MerkleDistributor private target;
    uint256 private rIndex;
    address private rAccount;
    uint256 private rAmount;
    bytes32[] private rProof;
    bool private reentered;

    uint256 public reentryAttempts;
    uint256 public reentrySuccesses;

    constructor(string memory n, string memory s, uint8 d) {
        name = n;
        symbol = s;
        decimals = d;
    }

    function mint(address to, uint256 amount) external {
        totalSupply += amount;
        balanceOf[to] += amount;
        emit Transfer(address(0), to, amount);
    }

    function armReentry(MerkleDistributor t, uint256 i, address a, uint256 amt, bytes32[] calldata p) external {
        target = t;
        rIndex = i;
        rAccount = a;
        rAmount = amt;
        rProof = p;
    }

    function transfer(address to, uint256 amount) external returns (bool) {
        balanceOf[msg.sender] -= amount;
        balanceOf[to] += amount;
        emit Transfer(msg.sender, to, amount);
        if (address(target) != address(0) && !reentered) {
            reentered = true; // attempt exactly once, keep the test deterministic
            reentryAttempts++;
            try target.claim(rIndex, rAccount, rAmount, rProof) {
                reentrySuccesses++;
            } catch {
                // expected: AlreadyClaimed from the CEI marking
            }
        }
        return true;
    }
}
