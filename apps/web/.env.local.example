# Swapex web — local anvil (chain 31337). All values default to the deterministic addresses
# produced by `contracts/script/Deploy.s.sol`; override only for a different deployment.
# NOTE: Deploy.s.sol deploys AllowanceTransfer between PoolManager and Router, so re-running it
# on a chain that already has nonces shifts every address below.
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_POOL_MANAGER=0x821f3361D454cc98b7555221A06Be563a7E2E0A6
NEXT_PUBLIC_ALLOWANCE_TRANSFER=0x1780bCf4103D3F501463AD3414c7f4b654bb7aFd
NEXT_PUBLIC_ROUTER=0x5133BBdfCCa3Eb4F739D599ee4eC45cBCD0E16c5
NEXT_PUBLIC_QUOTER=0x71089Ba41e478702e1904692385Be3972B2cBf9e
NEXT_PUBLIC_SWA=0xC66AB83418C20A65C3f8e83B3d11c8C3a6097b6F
NEXT_PUBLIC_SWB=0xeF31027350Be2c7439C1b0BE022d49421488b72C
