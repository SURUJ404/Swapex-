# Swapex web — local anvil (chain 31337). All values default to the deterministic addresses
# produced by `contracts/script/Deploy.s.sol`; override only for a different deployment.
# NOTE: Deploy.s.sol deploys AllowanceTransfer between PoolManager and Router, so re-running it
# on a chain that already has nonces shifts every address below.
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_POOL_MANAGER=0xffa7CA1AEEEbBc30C874d32C7e22F052BbEa0429
NEXT_PUBLIC_ALLOWANCE_TRANSFER=0x3aAde2dCD2Df6a8cAc689EE797591b2913658659
NEXT_PUBLIC_ROUTER=0xab16A69A5a8c12C732e0DEFF4BE56A70bb64c926
NEXT_PUBLIC_QUOTER=0xE3011A37A904aB90C8881a99BD1F6E21401f1522
NEXT_PUBLIC_SWA=0x1f10F3Ba7ACB61b2F50B9d6DdCf91a6f787C0E82
NEXT_PUBLIC_SWB=0x457cCf29090fe5A24c19c1bc95F492168C0EaFdb
