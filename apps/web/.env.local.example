# Swapex web — local anvil (chain 31337). All values default to the deterministic addresses
# produced by `contracts/script/Deploy.s.sol`; override only for a different deployment.
# NOTE: Deploy.s.sol deploys AllowanceTransfer between PoolManager and Router, so re-running it
# on a chain that already has nonces shifts every address below.
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_POOL_MANAGER=0x2bdCC0de6bE1f7D2ee689a0342D76F52E8EFABa3
NEXT_PUBLIC_ALLOWANCE_TRANSFER=0x7969c5eD335650692Bc04293B07F5BF2e7A673C0
NEXT_PUBLIC_ROUTER=0x7bc06c482DEAd17c0e297aFbC32f6e63d3846650
NEXT_PUBLIC_QUOTER=0xc351628EB244ec633d5f21fBD6621e1a683B1181
NEXT_PUBLIC_SWA=0xFD471836031dc5108809D173A067e8486B9047A3
NEXT_PUBLIC_SWB=0xcbEAF3BDe82155F56486Fb5a1072cb8baAf547cc
NEXT_PUBLIC_SWC=0x1429859428C0aBc9C2C47C8Ee9FBaf82cFA0F20f
