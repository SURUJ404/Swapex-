# Swapex web — local anvil (chain 31337). All values default to the deterministic addresses
# produced by `contracts/script/Deploy.s.sol`; override only for a different deployment.
# NOTE: Deploy.s.sol deploys AllowanceTransfer between PoolManager and Router, so re-running it
# on a chain that already has nonces shifts every address below.
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_POOL_MANAGER=0x87006e75a5B6bE9D1bbF61AC8Cd84f05D9140589
NEXT_PUBLIC_ALLOWANCE_TRANSFER=0x51C65cd0Cdb1A8A8b79dfc2eE965B1bA0bb8fc89
NEXT_PUBLIC_ROUTER=0x8fC8CFB7f7362E44E472c690A6e025B80E406458
NEXT_PUBLIC_QUOTER=0xC7143d5bA86553C06f5730c8dC9f8187a621A8D4
NEXT_PUBLIC_SWA=0xc9952Fc93Fa9bE383ccB39008c786b9f94eAc95d
NEXT_PUBLIC_SWB=0xDde063eBe8E85D666AD99f731B4Dbf8C98F29708
