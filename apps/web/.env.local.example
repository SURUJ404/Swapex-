# Swapex web — local anvil (chain 31337). All values default to the deterministic addresses
# produced by `contracts/script/Deploy.s.sol`; override only for a different deployment.
# NOTE: Deploy.s.sol deploys AllowanceTransfer between PoolManager and Router, so re-running it
# on a chain that already has nonces shifts every address below.
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_POOL_MANAGER=0xC9a43158891282A2B1475592D5719c001986Aaec
NEXT_PUBLIC_ALLOWANCE_TRANSFER=0x1c85638e118b37167e9298c2268758e058DdfDA0
NEXT_PUBLIC_ROUTER=0x367761085BF3C12e5DA2Df99AC6E1a824612b8fb
NEXT_PUBLIC_QUOTER=0x4C2F7092C2aE51D986bEFEe378e50BD4dB99C901
NEXT_PUBLIC_SWA=0x7A9Ec1d04904907De0ED7b6839CcdD59c3716AC9
NEXT_PUBLIC_SWB=0x49fd2BE640DB2910c2fAb69bB8531Ab6E76127ff
NEXT_PUBLIC_SWC=0x4631BCAbD6dF18D94796344963cB60d44a4136b6
