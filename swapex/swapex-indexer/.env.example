# Chain to index (must match a manifest in ../swapex-contracts/deployments/<id>.json)
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
DATABASE_PATH=./data/indexer.db
PORT=4000
# Comma-separated list of web origins allowed by CORS. Never use "*".
CORS_ORIGINS=http://localhost:3000
# Blocks kept unfinalized so reorgs can be rolled back
REORG_DEPTH=12
# Milliseconds between indexing passes
POLL_INTERVAL_MS=2000
# Optional: explicit path to the deployment manifest (defaults to ../swapex-contracts/deployments/<CHAIN_ID>.json)
# DEPLOYMENT_PATH=../swapex-contracts/deployments/31337.json
