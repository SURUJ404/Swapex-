# Chain to index (must match a manifest in ../swapex-contracts/deployments/<id>.json)
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
DATABASE_PATH=./data/indexer.db
PORT=4000
# Comma-separated list of web origins allowed by CORS. Never use "*".
CORS_ORIGINS=http://localhost:3000
# Blocks kept unfinalized so reorgs can be rolled back
REORG_DEPTH=12
