# Copy to .env.local (git-ignored). TESTNET ONLY.
#
# Every NEXT_PUBLIC_* value is shipped to the browser and visible to anyone.
# So never put a secret here. For RPC keys, create a key restricted to your site's domain
# (and to the testnet chains) in your provider's dashboard.

# 11155111 = Sepolia, 84532 = Base Sepolia, 421614 = Arbitrum Sepolia
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_RPC_URL=
# set to "true" only for a real mainnet launch after an audit
NEXT_PUBLIC_ALLOW_MAINNET=false
